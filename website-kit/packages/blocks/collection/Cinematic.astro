---
import type { VariantData } from './schema';
interface Props {id:string;data:VariantData<'cinematic-reveal'>}
const {id,data}=Astro.props;
---
<section id={id} class="cb cb-cinema" data-cinematic style={`--cb-duration:${data.durationMs}ms;--cb-overlay:${data.overlay}`} aria-label={data.heading}>
  <div class="cb-cinema-media">
    <img src={data.image.src} alt={data.image.alt} style={`object-position:${data.image.position}`} fetchpriority="high" />
    {data.video && <video muted loop playsinline preload="none" poster={data.image.src} aria-label={data.image.alt}><source src={data.video} /></video>}
  </div>
  <div class="cb-cinema-copy"><h2>{data.heading}</h2><p>{data.intro}</p>{data.cta && <a class="cb-link cb-link-light" href={data.cta.href}>{data.cta.label} <span aria-hidden="true">↗</span></a>}</div>
  {data.video && <button class="cb-video-toggle cb-button" hidden type="button">Play video</button>}
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-cinematic]').forEach(root=>{
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    const video=root.querySelector('video'); const button=root.querySelector<HTMLButtonElement>('.cb-video-toggle');
    let userPaused=false;
    const sync=()=>{if(button&&video)button.textContent=video.paused?'Play video':'Pause video';};
    if(video&&button){button.hidden=false;video.addEventListener('play',sync);video.addEventListener('pause',sync);button.addEventListener('click',()=>{userPaused=!video.paused;if(video.paused)void video.play().catch(sync);else video.pause();});}
    if(!reduced.matches)root.classList.add('cb-cinema-ready');
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{
      if(entry.isIntersecting){root.classList.add('cb-cinema-entered');if(video&&!reduced.matches&&!userPaused)void video.play().catch(sync);}
      else video?.pause();
    }),{threshold:.15});observer.observe(root);
    reduced.addEventListener('change',()=>{if(reduced.matches){root.classList.remove('cb-cinema-ready');video?.pause();}});
  });
</script>
