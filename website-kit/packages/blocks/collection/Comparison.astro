---
import type { VariantData } from './schema';
interface Props {id:string;data:VariantData<'before-after'>}
const {id,data}=Astro.props;
---
<section id={id} class="cb cb-section" data-comparison>
  <header class="cb-heading"><h2>{data.heading}</h2><p>{data.intro}</p></header>
  <div class="cb-compare" style={`--cb-split:${data.initial}%`}>
    <figure class="cb-compare-before"><img src={data.before.src} alt={data.before.alt} loading="lazy" style={`object-position:${data.before.position}`} /><figcaption>{data.beforeLabel}</figcaption></figure>
    <figure class="cb-compare-after"><img src={data.after.src} alt={data.after.alt} loading="lazy" style={`object-position:${data.after.position}`} /><figcaption>{data.afterLabel}</figcaption></figure>
    <span class="cb-compare-divider" aria-hidden="true"><span>↔</span></span>
  </div>
  <label class="cb-compare-control" hidden><span>{data.beforeLabel} / {data.afterLabel}</span><input type="range" min="0" max="100" value={data.initial} aria-label={`Compare ${data.beforeLabel} and ${data.afterLabel}`} /><output>{data.initial}%</output></label>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-comparison]').forEach(root=>{
    const stage=root.querySelector<HTMLElement>('.cb-compare')!;const input=root.querySelector('input')!;const output=root.querySelector('output')!;
    const update=(value:number)=>{const rounded=Math.round(Math.min(100,Math.max(0,value)));input.value=String(rounded);stage.style.setProperty('--cb-split',`${rounded}%`);output.value=`${rounded}%`;input.setAttribute('aria-valuetext',`${rounded}% ${root.querySelector('.cb-compare-after figcaption')!.textContent}`);};
    input.addEventListener('input',()=>update(Number(input.value)));
    const move=(event:PointerEvent)=>{const bounds=stage.getBoundingClientRect();update((event.clientX-bounds.left)/bounds.width*100);};
    stage.addEventListener('pointerdown',event=>{if(event.button!==0)return;stage.setPointerCapture(event.pointerId);input.focus({preventScroll:true});move(event);});
    stage.addEventListener('pointermove',event=>{if(stage.hasPointerCapture(event.pointerId))move(event);});
    stage.addEventListener('pointerup',event=>{if(stage.hasPointerCapture(event.pointerId))stage.releasePointerCapture(event.pointerId);});
    root.dataset.enhanced='true';root.querySelector<HTMLElement>('.cb-compare-control')!.hidden=false;update(Number(input.value));
  });
</script>
