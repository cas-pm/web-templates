---
import type { FooterProps } from "./schema";
interface Props { data: FooterProps; id?: string }
const { data, id } = Astro.props;
---
<footer id={id} class="mk-footer" data-block="footer">{data.columns.map(column => <div><h3>{column.title}</h3><ul role="list">{column.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>)}<div><nav aria-label="Legal">{data.legalLinks.map(link => <a href={link.href}>{link.label}</a>)}</nav>{data.copyright && <p>{data.copyright}</p>}</div></footer>