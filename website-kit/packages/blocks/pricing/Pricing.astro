---
import type { PricingProps } from "./schema";
interface Props { data: PricingProps; id?: string }
const { data, id } = Astro.props;
---
<section id={id} class="mk-section mk-pricing" data-block="pricing">{data.heading && <h2>{data.heading}</h2>}<div class="mk-pricing-grid">{data.plans.map(plan => <article class:list={[{ 'mk-plan-featured': plan.featured }]}>{plan.featured && <span class="mk-caption">Recommended</span>}<h3>{plan.name}</h3><p class="mk-price">{plan.price}<span>{plan.period}</span></p><ul>{plan.features.map(feature => <li>{feature}</li>)}</ul><a class="mk-button" href={plan.cta.href}>{plan.cta.label}<span aria-hidden="true">↗</span></a></article>)}</div></section>