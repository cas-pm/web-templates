---
import CuratedSections from './CuratedSections.astro';
interface Section { id: string; type: string; label: string; data: any }
interface Props { sections: Section[]; template: string }
const { sections, template } = Astro.props;
---
<div class="catalog">
  <aside class="catalog-sidebar" aria-label="Section library">
    <div class="catalog-title"><span>SECTION LIBRARY</span><h1>{template}</h1><p>Select a section to inspect the rendered block and its editable name.</p></div>
    <nav aria-label="Sections on this page">{sections.map((section, i) => <a href={`#${section.id}`}><span>{String(i+1).padStart(2,'0')}</span><span>{section.label}<small>{section.type}</small></span></a>)}</nav>
    <a class="catalog-back" href="/">← Back to website</a>
  </aside>
  <div class="catalog-main"><div class="catalog-intro"><span>LIVE COMPONENT PREVIEW</span><h2>Every section, clearly named.</h2><p>Copy a section entry from <code>content/pages.json</code> into any page's <code>sections</code> array. Give it a unique ID and edit its data.</p></div><CuratedSections sections={sections} /></div>
</div>
<style is:global>
  .catalog{display:grid;grid-template-columns:minmax(230px,280px) minmax(0,1fr)}
  .catalog-sidebar{position:sticky;top:0;height:100svh;overflow:auto;padding:2rem 1.2rem;background:var(--mk-ink);color:var(--mk-paper)}
  .catalog-title{padding:.3rem .7rem 1.7rem}.catalog-title>span,.catalog-intro>span{font-size:.7rem;letter-spacing:.16em;font-weight:700}.catalog-title h1{font-size:1.6rem;margin:.5rem 0}.catalog-title p{font-size:.86rem;opacity:.72;line-height:1.5}
  .catalog-sidebar nav{display:grid;gap:.25rem}.catalog-sidebar nav a{color:inherit;text-decoration:none;display:grid;grid-template-columns:2rem 1fr;padding:.7rem;border-radius:7px}.catalog-sidebar nav a:hover,.catalog-sidebar nav a:focus-visible{background:#ffffff25}.catalog-sidebar nav a>span:first-child{opacity:.5}.catalog-sidebar small{display:block;opacity:.55;font-size:.7rem;margin-top:.15rem}.catalog-back{color:inherit;display:block;margin:2rem .7rem}
  .catalog-intro{padding:clamp(2rem,5vw,5rem);background:var(--mk-surface)}.catalog-intro h2{font-size:clamp(2rem,4vw,4rem);max-width:15ch;margin:.7rem 0}.catalog-intro p{max-width:58ch;line-height:1.6}.catalog-main{min-width:0}.catalog-main .curated-section{border-top:3px solid var(--mk-accent)}
  @media(max-width:760px){.catalog{display:block}.catalog-sidebar{position:relative;height:auto}.catalog-sidebar nav{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
