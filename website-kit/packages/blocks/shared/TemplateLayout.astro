---
import DesignSystem from './DesignSystem.astro';
import Header from '../header/Header.astro';
import { HeaderPropsSchema } from '../header/schema';
interface Props {
  catalogMode?: boolean;
  title: string; description: string; name: string; tagline: string; email: string;
  links: { label: string; href: string }[];
  navigation?: { sticky?: boolean; menuLabel?: string; closeLabel?: string; logoImage?: string };
  navCta?: { label: string; href: string };
  theme?: 'professional' | 'hospitality' | 'adventure';
}
const { catalogMode = false, navigation = {}, title, description, name, tagline, email, links, theme = 'professional', navCta = { label: 'Contact', href: '#contact' } } = Astro.props;
const header = HeaderPropsSchema.parse({ ...navigation, logoText: name, links, cta: navCta });
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><title>{title}</title><DesignSystem /></head>
  <body class="mk-site" data-theme={theme}>
    <a class="mk-skip" href="#main">Skip to content</a>
    {!catalogMode && <Header data={header} />}
    <main id="main" class="mk-page"><slot /></main>
    {!catalogMode && <div class="mk-shell">
      <footer class="mk-footer"><div><a class="mk-brand" href="/">{name}</a><p>{tagline}</p></div><div><a href={`mailto:${email}`}>{email}</a><p>© {new Date().getFullYear()} {name}</p></div><nav aria-label="Footer">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav></footer>
    </div>}
  </body>
</html>
<style is:global>
  .mk-site[data-theme="professional"] { --mk-paper: #f3f2f8; --mk-ink: #29263f; --mk-muted: #646177; --mk-accent: #554a91; --mk-surface: #e5e1f0; --mk-line: #d6d1e2; }
  .mk-site[data-theme="hospitality"] { --mk-paper: #f3f5ef; --mk-ink: #263f32; --mk-muted: #586d60; --mk-accent: #365c48; --mk-surface: #e1e8dc; --mk-line: #cbd6c8; --mk-heading: "Palatino Linotype", "Book Antiqua", Palatino, serif; --mk-radius: 8px; }
  .mk-site[data-theme="hospitality"] .mk-hero:not(.mk-hero--immersive) .mk-hero-media { border-radius: 48% 48% 8px 8px; }
  .mk-site[data-theme="hospitality"] h1 { font-weight: 400; }
  .mk-site[data-theme="adventure"] { --mk-paper: #faf5eb; --mk-ink: #282720; --mk-muted: #675f50; --mk-accent: #a44b2b; --mk-surface: #eee2d0; --mk-line: #dbc9ae; --mk-heading: Georgia, 'Times New Roman', serif; --mk-radius: 6px; }
  .mk-site[data-theme="adventure"] .mk-hero h1 { font-weight: 400; max-width: 900px; }
</style>
