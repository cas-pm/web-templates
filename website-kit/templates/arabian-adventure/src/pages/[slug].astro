---
import TemplateLayout from '@web/blocks/shared/TemplateLayout.astro';
import CuratedSections from '@web/blocks/shared/CuratedSections.astro';
import content from '../../content/home.json';
import pages from '../../content/pages.json';
export function getStaticPaths() { return pages.pages.filter(p => p.slug !== 'home').map(page => ({params:{slug:page.slug},props:{page}})); }
const { page } = Astro.props;
const links = pages.pages.filter(p => p.slug !== 'home').map(p => ({label:p.title,href:`/${p.slug}`}));
---
<TemplateLayout title={`${page.title} · ${content.name}`} {...content} description={page.description} links={links} navCta={{label:'Contact',href:'/contact'}} theme="adventure"><CuratedSections sections={page.sections} /></TemplateLayout>
