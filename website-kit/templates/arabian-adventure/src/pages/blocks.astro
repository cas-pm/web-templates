---
import TemplateLayout from '@web/blocks/shared/TemplateLayout.astro';
import BlockCatalog from '@web/blocks/shared/BlockCatalog.astro';
import content from '../../content/home.json';
import pages from '../../content/pages.json';
type Section = (typeof pages.pages)[number]['sections'][number];
const sections = pages.pages.flatMap<Section>(page => page.sections).filter((section,index,all) => all.findIndex(other => other.type === section.type) === index).map((section,index) => ({...section,id:`preview-${index}-${section.id}`}));
---
<TemplateLayout title={`Section library · ${content.name}`} {...content} links={[{label:'Home',href:'/'}]} theme="adventure"><BlockCatalog sections={sections} template={content.name} /></TemplateLayout>
