---
import type { Block } from "@web/blocks/schemas";
import Hero from "@web/blocks/hero/Hero.astro";
import Services from "@web/blocks/services/Services.astro";
import Faq from "@web/blocks/faq/Faq.astro";
import Cta from "@web/blocks/cta/Cta.astro";
interface Props { block: Block }
const { block } = Astro.props;
---
{block.type === "hero" && <Hero data={{ ...block, variant: block.variant ?? (block.image ? "full-bleed" : "centered"), media: block.media ?? block.image }} />}
{block.type === "services" && <Services data={{ eyebrow: block.eyebrow, heading: block.heading, intro: block.intro, items: block.items }} />}
{block.type === "faq" && <Faq data={{ heading: block.heading, items: block.items, emitJsonLd: false }} />}
{block.type === "cta" && <Cta data={block} />}
{block.type === "richText" && <section class="mk-section story">
  <div>{block.eyebrow && <span class="mk-caption">{block.eyebrow}</span>}{block.heading && <h2>{block.heading}</h2>}</div>
  <div class="story-copy">{block.body.map(p => <p>{p}</p>)}</div>
</section>}
{block.type === "serviceCard" && <section class="mk-section"><h2>{block.title}</h2><p>{block.description}</p>{block.cta && <a class="mk-button" href={block.cta.href}>{block.cta.label}</a>}</section>}
{block.type === "legal" && <article class="mk-section legal">
  {block.needsLegalReview && <p class="notice" data-legal-review-required>Draft — requires client legal review before publishing.</p>}
  <h1>{block.heading}</h1>{block.body.split("\n\n").map(p => <p>{p}</p>)}
</article>}
<style>
  .story { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(2rem, 7vw, 8rem); border-top: 1px solid var(--mk-line); }
  .story-copy { color: var(--mk-muted); font-size: 1.1rem; }
  .story-copy p:first-child { margin-top: 0; }
  .legal { max-width: 760px; margin-inline: auto; }
  .legal h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
  .notice { background: #fef3c7; color: #92400e; padding: 1rem; border-radius: 8px; }
  @media(max-width: 760px) { .story { grid-template-columns: 1fr; gap: 1rem; } }
</style>
