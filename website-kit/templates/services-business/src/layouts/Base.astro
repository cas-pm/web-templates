---
import Header from "@web/blocks/header/Header.astro";
import { HeaderPropsSchema } from "@web/blocks/header/schema";
import DesignSystem from "@web/blocks/shared/DesignSystem.astro";
import Seo from "@web/seo/Seo.astro";
import { defaultTheme, themeToCss } from "@web/tokens";
import { organizationJsonLd } from "@web/seo";
import { site } from "../lib/site.ts";

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const currentPath = Astro.url.pathname;

const orgJsonLd = organizationJsonLd({
  name: site.name,
  url: site.url,
  telephone: site.phone,
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo title={pageTitle} description={description} canonical={new URL(currentPath, site.url).href} jsonLd={[orgJsonLd]} />
    <style set:html={themeToCss(defaultTheme)}></style>
    <DesignSystem />
  </head>
  <body class="mk-site">
    <a class="mk-skip" href="#main">Skip to content</a>
    <Header data={HeaderPropsSchema.parse({ ...site.navigation, logoText: site.shortName, links: site.nav, cta: site.navCta })} />
    <main id="main" class="mk-page"><slot /></main>
    <div class="mk-shell">
      <footer class="mk-footer">
        <div><a class="mk-brand" href="/">{site.shortName}</a><p>{site.tagline}</p><p>{site.address}</p></div>
        <div><p><a href={site.phoneHref}>{site.phone}</a></p><p><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
        <nav aria-label="Legal">{site.legalNav.map(link => <a href={link.href}>{link.label}</a>)}</nav>
        <p>© {new Date().getFullYear()} {site.name}. Company no. {site.companyNumber} · VAT {site.vatNumber}</p>
      </footer>
    </div>
  </body>
</html>
<style is:global>
  .mk-site { --color-bg: var(--mk-paper); --color-fg: var(--mk-ink); --color-primary: var(--mk-accent); --color-muted: var(--mk-muted); --color-border: var(--mk-line); --font-body: var(--mk-body); --font-heading: var(--mk-heading); }
  .mk-site .section { padding-block: var(--mk-space); }
  .mk-site .section-inner { margin-inline: auto; }
  .mk-site .section-narrow .section-inner { max-width: 760px; }
  .mk-site .btn { display: inline-flex; align-items: center; padding: .9rem 1.5rem; border-radius: 100px; text-decoration: none; font-weight: 600; border: 1px solid var(--mk-line); }
  .mk-site .btn-primary { background: var(--mk-accent); color: white; }
  .mk-site .btn-secondary { background: var(--mk-ink); color: white; }
  .mk-site .btn-ghost { background: transparent; color: var(--mk-ink); }
  .mk-nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
</style>
